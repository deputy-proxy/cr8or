APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=r2
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

OPENAI_API_KEY=
OPENAI_URL=https://api.openai.com/v1
CR8OR_AI_PROVIDER=openai

VITE_APP_NAME="${APP_NAME}"
# Optional managed credentials for read-only GitHub issue synchronization.
GITHUB_ACCESS_TOKEN=
GITHUB_CREDENTIALS={}
GITHUB_TIMEOUT=15

# Native social authorization. Register each callback URL exactly as shown in docs/social-authorization.md.
SOCIAL_AUTH_TIMEOUT=15
SOCIAL_AUTH_ATTEMPT_TTL_MINUTES=10
SOCIAL_AUTH_REFRESH_LOCK_SECONDS=30
SOCIAL_AUTH_REFRESH_LOCK_WAIT_SECONDS=10
SOCIAL_AUTH_REFRESH_LEEWAY_SECONDS=300
SOCIAL_PUBLISHING_LINKEDIN_ENABLED=false
SOCIAL_PUBLISHING_FACEBOOK_ENABLED=false
SOCIAL_PUBLISHING_INSTAGRAM_ENABLED=false
SOCIAL_PUBLISHING_TIKTOK_ENABLED=false
SOCIAL_PUBLISHING_BSKY_ENABLED=false
SOCIAL_PUBLISHING_YOUTUBE_ENABLED=false
SOCIAL_PUBLISHING_THREADS_ENABLED=false
SOCIAL_PUBLISHING_X_ENABLED=false
SOCIAL_LINKEDIN_API_VERSION=202609
SOCIAL_LINKEDIN_CLIENT_ID=
SOCIAL_LINKEDIN_CLIENT_SECRET=
SOCIAL_LINKEDIN_REDIRECT_URI=${APP_URL}/social/authorization/callback/linkedin
META_GRAPH_API_VERSION=v26.0
SOCIAL_INSTAGRAM_CONTAINER_POLL_ATTEMPTS=5
SOCIAL_INSTAGRAM_CONTAINER_POLL_INTERVAL_MS=250
META_APP_ID=
META_APP_SECRET=
META_SOCIAL_REDIRECT_URI=${APP_URL}/social/authorization/callback/meta
SOCIAL_TIKTOK_CLIENT_KEY=
SOCIAL_TIKTOK_CLIENT_SECRET=
SOCIAL_TIKTOK_REDIRECT_URI=${APP_URL}/social/authorization/callback/tiktok
SOCIAL_TIKTOK_UPLOAD_TIMEOUT=120
SOCIAL_YOUTUBE_CLIENT_ID=
SOCIAL_YOUTUBE_CLIENT_SECRET=
SOCIAL_YOUTUBE_REDIRECT_URI=${APP_URL}/social/authorization/callback/youtube
SOCIAL_THREADS_CLIENT_ID=
SOCIAL_THREADS_CLIENT_SECRET=
SOCIAL_THREADS_REDIRECT_URI=${APP_URL}/social/authorization/callback/threads
SOCIAL_THREADS_API_VERSION=v1.0
SOCIAL_THREADS_MEDIA_URL_EXPIRY_MINUTES=60
SOCIAL_X_CLIENT_ID=
SOCIAL_X_CLIENT_SECRET=
SOCIAL_X_REDIRECT_URI=${APP_URL}/social/authorization/callback/x
SOCIAL_X_API_BASE_URL=https://api.x.com/2
# AT Protocol OAuth. The client ID must be the public HTTPS metadata-document URL.
SOCIAL_BSKY_OAUTH_ENABLED=false
SOCIAL_BSKY_CLIENT_ID=${APP_URL}/oauth-client-metadata.json
SOCIAL_BSKY_CLIENT_NAME=${APP_NAME}
SOCIAL_BSKY_CLIENT_URI=${APP_URL}
SOCIAL_BSKY_REDIRECT_URI=${APP_URL}/social/authorization/callback/bluesky

SOCIAL_YOUTUBE_MAX_UPLOAD_BYTES=256000000000
SOCIAL_YOUTUBE_DEFAULT_PRIVACY_STATUS=private
SOCIAL_YOUTUBE_DEFAULT_CATEGORY_ID=
SOCIAL_YOUTUBE_NOTIFY_SUBSCRIBERS=false
SOCIAL_YOUTUBE_UPLOAD_TIMEOUT=120
SOCIAL_YOUTUBE_UPLOAD_CHUNK_SIZE=8388608
PUBLISHING_STATUS_QUEUE_CONNECTION=database
PUBLISHING_STATUS_INITIAL_DELAY_SECONDS=60
PUBLISHING_STATUS_POLL_DELAY_SECONDS=300
PUBLISHING_STATUS_MAX_POLLS=48